    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestId",
        "target",
        "lifecycle",
        "sequence",
        "issuedAt",
        "expiresAt",
        "previousDigest",
        "resourceSet",
        "healthGates",
        "rollbackTarget"
      ],
      "properties": {
        "manifestId": {
          "$ref": "#/$defs/identifier"
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "lifecycle": {
          "enum": [
            "ACTIVE",
            "ABSENT",
            "DECOMMISSION"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issuedAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "expiresAt": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "previousDigest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256Digest"
            }
          ]
        },
        "resourceSet": {
          "$ref": "#/$defs/resourceSet"
        },
        "healthGates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/tenantHealthGate"
              },
              {
                "$ref": "#/$defs/clusterHealthGate"
              }
            ]
          }
        },
        "rollbackTarget": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/tenantRollbackTarget"
            },
            {
              "$ref": "#/$defs/clusterRollbackTarget"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sequence": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "previousDigest": {
                "type": "null"
              },
              "rollbackTarget": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "previousDigest": {
                "$ref": "#/$defs/sha256Digest"
              },
              "rollbackTarget": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "target": {
                "properties": {
                  "scope": {
                    "const": "TENANT"
                  }
                },
                "required": [
                  "scope"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "lifecycle": {
                "enum": [
                  "ACTIVE",
                  "ABSENT"
                ]
              },
              "resourceSet": {
                "properties": {
                  "artifacts": {
                    "items": {
                      "$ref": "#/$defs/tenantArtifact"
                    }
                  },
                  "secretReferences": {
                    "items": {
                      "$ref": "#/$defs/tenantSecretReference"
                    }
                  },
                  "resources": {
                    "items": {
                      "$ref": "#/$defs/tenantResource"
                    }
                  }
                }
              },
              "healthGates": {
                "items": {
                  "$ref": "#/$defs/tenantHealthGate"
                }
              },
              "rollbackTarget": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/tenantRollbackTarget"
                  }
                ]
              }
            }
          },
          "else": {
            "properties": {
              "lifecycle": {
                "enum": [
                  "ACTIVE",
                  "DECOMMISSION"
                ]
              },
              "resourceSet": {
                "properties": {
                  "artifacts": {
                    "items": {
                      "$ref": "#/$defs/clusterArtifact"
                    }
                  },
                  "secretReferences": {
                    "items": {
                      "$ref": "#/$defs/clusterSecretReference"
                    }
                  },
                  "resources": {
                    "items": {
                      "$ref": "#/$defs/clusterResource"
                    }
                  }
                }
              },
              "healthGates": {
                "items": {
                  "$ref": "#/$defs/clusterHealthGate"
                }
              },
              "rollbackTarget": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/clusterRollbackTarget"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "target": {
                "properties": {
                  "scope": {
                    "const": "TENANT"
                  }
                },
                "required": ["scope"]
              },
              "lifecycle": {
                "const": "ACTIVE"
              }
            },
            "required": ["target", "lifecycle"]
          },
          "then": {
            "properties": {
              "resourceSet": {
                "$ref": "#/$defs/tenantActiveResourceSet"
              },
              "healthGates": {
                "$ref": "#/$defs/tenantActiveHealthGates"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "target": {
                "properties": {
                  "scope": {
                    "const": "TENANT"
                  }
                },
                "required": ["scope"]
              },
              "lifecycle": {
                "const": "ABSENT"
              }
            },
            "required": ["target", "lifecycle"]
          },
          "then": {
            "properties": {
              "resourceSet": {
                "$ref": "#/$defs/tenantAbsentResourceSet"
              },
              "healthGates": {
                "$ref": "#/$defs/tenantAbsentHealthGates"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "target": {
                "properties": {
                  "scope": {
                    "const": "CLUSTER"
                  }
                },
                "required": ["scope"]
              },
              "lifecycle": {
                "const": "ACTIVE"
              }
            },
            "required": ["target", "lifecycle"]
          },
          "then": {
            "properties": {
              "resourceSet": {
                "$ref": "#/$defs/clusterActiveResourceSet"
              },
              "healthGates": {
                "$ref": "#/$defs/clusterActiveHealthGates"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "target": {
                "properties": {
                  "scope": {
                    "const": "CLUSTER"
                  }
                },
                "required": ["scope"]
              },
              "lifecycle": {
                "const": "DECOMMISSION"
              }
            },
            "required": ["target", "lifecycle"]
          },
          "then": {
            "properties": {
              "resourceSet": {
                "$ref": "#/$defs/clusterDecommissionResourceSet"
              },
              "healthGates": {
                "$ref": "#/$defs/clusterDecommissionHealthGates"
              }
            }
          }
        }
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyId",
        "algorithm",
        "createdAt",
        "value"
      ],
      "properties": {
