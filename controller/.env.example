DJANGO_SECRET_KEY=replace-with-a-random-deployment-secret
VIVOLUTION_RELEASE_ID=cp1-replace-with-immutable-release-id
DJANGO_ALLOWED_HOSTS=controller.example.test
DJANGO_CSRF_TRUSTED_ORIGINS=https://controller.example.test
DJANGO_TRUST_X_FORWARDED_PROTO=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_SESSION_ENGINE=db
DJANGO_SESSION_COOKIE_AGE_SECONDS=3600
RLS_CONTEXT_SIGNING_KEY=replace-with-64-lowercase-hex-characters
RLS_CONTEXT_TTL_SECONDS=60
DATABASE_URL=postgresql://cp_runtime:replace-me@127.0.0.1:6432/vivolution?sslmode=disable
