[global]
type=global
user_agent=Vivolution-No-PSTN-Fixture/0.1
max_forwards=20

[fixture-mutual-tls]
type=transport
protocol=tls
bind={{ voice_fixture_controller_ipv4 }}:{{ voice_fixture_asterisk_tls_port }}
method=tlsv1_2
cert_file=/run/fixture-pki/asterisk.crt
priv_key_file=/run/fixture-pki/asterisk.key
ca_list_file=/run/fixture-pki/combined-ca.crt
verify_client=yes
require_client_cert=yes
verify_server=yes
allow_reload=no
local_net=10.20.0.0/16

[edge-inbound]
type=endpoint
transport=fixture-mutual-tls
context=from-edge
disallow=all
allow=ulaw
allow=alaw
direct_media=no
rtp_symmetric=no
force_rport=no
rewrite_contact=no
timers=yes
trust_id_inbound=no
send_pai=no

[edge-source-sbc1]
type=identify
endpoint=edge-inbound
match={{ voice_fixture_sbc1_ipv4 }}

[edge-source-sbc2]
type=identify
endpoint=edge-inbound
match={{ voice_fixture_sbc2_ipv4 }}

[sbc1-aor]
type=aor
contact=sips:{{ voice_fixture_sbc1_server_name }}:{{ voice_fixture_edge_pbx_mtls_port }}
qualify_frequency=0

[sbc1]
type=endpoint
transport=fixture-mutual-tls
aors=sbc1-aor
context=reject-all
disallow=all
allow=ulaw
allow=alaw
direct_media=no
rtp_symmetric=no
force_rport=no
rewrite_contact=no
timers=yes
from_domain=pbx-fixture.invalid

[sbc2-aor]
type=aor
contact=sips:{{ voice_fixture_sbc2_server_name }}:{{ voice_fixture_edge_pbx_mtls_port }}
qualify_frequency=0

[sbc2]
type=endpoint
transport=fixture-mutual-tls
aors=sbc2-aor
context=reject-all
disallow=all
allow=ulaw
allow=alaw
direct_media=no
rtp_symmetric=no
force_rport=no
rewrite_contact=no
timers=yes
from_domain=pbx-fixture.invalid
