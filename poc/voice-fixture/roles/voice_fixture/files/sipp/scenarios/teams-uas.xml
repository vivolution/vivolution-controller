<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<scenario name="Vivolution synthetic PBX to Teams">
  <recv request="INVITE" crlf="true" rrs="true">
    <action>
      <ereg regexp="^INVITE sips?:\+9710000001001@" search_in="msg" check_it="true" assign_to="fixture_uri" />
      <ereg regexp="no-pstn" search_in="hdr" header="X-Vivolution-Fixture" check_it="true" assign_to="fixture_marker" />
    </action>
  </recv>
  <Reference variables="fixture_uri,fixture_marker" />

  <send>
    <![CDATA[
      SIP/2.0 100 Trying
      [last_Via:]
      [last_From:]
      [last_To:];tag=fixture-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:];tag=fixture-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:teams-fixture@[local_ip]:[local_port];transport=tls>
      Content-Length: 0
    ]]>
  </send>

  <pause milliseconds="250" />

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:];tag=fixture-[pid]-[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:teams-fixture@[local_ip]:[local_port];transport=tls>
      Supported: timer
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=fixture 2 2 IN IP4 [local_ip]
      s=Vivolution no-PSTN fixture
      c=IN IP4 [local_ip]
      t=0 0
      m=audio 22000 RTP/AVP 0 8
      a=rtpmap:0 PCMU/8000
      a=rtpmap:8 PCMA/8000
      a=sendrecv
    ]]>
  </send>

  <recv request="ACK" crlf="true" rrs="true">
    <action>
      <ereg regexp=": *(.*)" search_in="hdr" header="To" assign_to="_,fixture_us" />
      <ereg regexp=": *(.*)" search_in="hdr" header="From" assign_to="_,fixture_them" />
    </action>
  </recv>
  <Reference variables="_" />
  <pause milliseconds="3000" />

  <send retrans="500" start_txn="bye">
    <![CDATA[
      BYE [next_url] SIP/2.0
      Via: SIP/2.0/TLS [local_ip]:[local_port];branch=[branch]
      [routes]
      From: [$fixture_us]
      To: [$fixture_them]
      [last_Call-ID:]
      CSeq: [cseq] BYE
      Contact: <sip:teams-fixture@[local_ip]:[local_port];transport=tls>
      Max-Forwards: 20
      Content-Length: 0
    ]]>
  </send>

  <recv response="200" response_txn="bye" crlf="true" />

  <ResponseTimeRepartition value="10,20,50,100,150,200,500,1000,2000,5000" />
  <CallLengthRepartition value="1000,2000,3000,4000,5000,10000" />
</scenario>
