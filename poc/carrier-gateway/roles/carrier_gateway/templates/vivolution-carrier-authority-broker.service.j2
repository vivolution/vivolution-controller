[Unit]
Description=Vivolution root-owned one-call authority broker
Requires=vivolution-carrier-authority-broker.socket
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/libexec/vivolution-carrier-authority-broker \
  --authorization-root {{ carrier_gateway_state_root }}/authorization \
  --expected-uid {{ carrier_gateway_egress_uid }} \
  --max-seconds {{ carrier_gateway_provider_max_call_seconds }} \
  --max-spend-microusd {{ (carrier_gateway_provider_maximum_spend_per_call_usd | float * 1000000) | int }} \
  --request-timeout-ms 1000 \
  --max-connections 4 \
  serve
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths={{ carrier_gateway_state_root }}/authorization
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
