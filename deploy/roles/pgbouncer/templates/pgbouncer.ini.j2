[databases]
{{ cp_database_name }} = host={{ cp_db_upstream_host }} port={{ cp_db_upstream_port }} dbname={{ cp_database_name }}

[pgbouncer]
listen_addr = {{ cp_pgbouncer_host }}
listen_port = {{ cp_pgbouncer_port }}
unix_socket_dir = /run/postgresql
auth_type = scram-sha-256
auth_file = /etc/pgbouncer/userlist.txt
pool_mode = transaction
max_client_conn = {{ cp_pgbouncer_max_client_conn }}
default_pool_size = {{ cp_pgbouncer_default_pool_size }}
reserve_pool_size = 5
server_reset_query = DISCARD ALL
server_check_query = SELECT 1
server_check_delay = 10
query_wait_timeout = {{ cp_pgbouncer_query_wait_timeout }}
server_connect_timeout = {{ cp_pgbouncer_server_connect_timeout }}
server_login_retry = {{ cp_pgbouncer_server_login_retry }}
ignore_startup_parameters = extra_float_digits
{% if cp_profile == 'azure' %}
server_tls_sslmode = {{ cp_db_server_tls_sslmode }}
server_tls_ca_file = /etc/ssl/certs/ca-certificates.crt
{% else %}
server_tls_sslmode = disable
{% endif %}
log_connections = 1
log_disconnections = 1
admin_users = {{ cp_db_owner }}
stats_users = {{ cp_db_owner }}
