DJANGO_SECRET_KEY={{ cp_django_secret_key }}
DJANGO_ALLOWED_HOSTS={{ cp_controller_allowed_hosts }}
DJANGO_CSRF_TRUSTED_ORIGINS={{ cp_controller_csrf_origins }}
DJANGO_CSRF_COOKIE_SECURE={{ cp_controller_cookie_secure | ternary('true', 'false') }}
DJANGO_SESSION_COOKIE_SECURE={{ cp_controller_cookie_secure | ternary('true', 'false') }}
DJANGO_TRUST_X_FORWARDED_PROTO={{ cp_controller_trust_forwarded_proto | ternary('true', 'false') }}
DJANGO_SECURE_SSL_REDIRECT={{ cp_controller_ssl_redirect | ternary('true', 'false') }}
DJANGO_SECURE_HSTS_SECONDS={{ 3600 if cp_profile == 'azure' else 0 }}
DATABASE_URL=postgresql://{{ cp_db_runtime_user }}:{{ cp_db_runtime_password }}@{{ cp_pgbouncer_host }}:{{ cp_pgbouncer_port }}/{{ cp_database_name }}?sslmode=disable
GUNICORN_BIND=127.0.0.1:{{ cp_controller_web_port }}
WEB_CONCURRENCY={{ cp_controller_web_workers }}
