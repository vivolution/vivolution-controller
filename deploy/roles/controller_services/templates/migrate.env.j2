DJANGO_SECRET_KEY={{ cp_django_secret_key }}
DJANGO_ALLOWED_HOSTS={{ cp_controller_allowed_hosts }}
DJANGO_CSRF_TRUSTED_ORIGINS={{ cp_controller_csrf_origins }}
DJANGO_SUPERUSER_PASSWORD={{ cp_controller_admin_password }}
{% if cp_profile == 'azure' %}
DATABASE_URL=postgresql://{{ cp_db_owner }}:{{ cp_db_owner_password }}@{{ cp_db_upstream_host }}:{{ cp_db_upstream_port }}/{{ cp_database_name }}?sslmode={{ cp_db_server_tls_sslmode }}
{% else %}
DATABASE_URL=postgresql://{{ cp_db_owner }}:{{ cp_db_owner_password }}@{{ cp_db_upstream_host }}:{{ cp_db_upstream_port }}/{{ cp_database_name }}?sslmode=disable
{% endif %}

