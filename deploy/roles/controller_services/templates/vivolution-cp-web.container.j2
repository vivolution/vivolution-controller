[Unit]
Description=Vivolution CP1 operator web application
After=network-online.target pgbouncer.service
Requires=pgbouncer.service

[Container]
Image={{ cp_controller_quadlet_image }}
ContainerName=vivolution-cp-web
Network=host
EnvironmentFile={{ cp_controller_quadlet_environment_file }}
ReadOnly=true
Tmpfs=/tmp:rw,size=64m,mode=1777
Tmpfs=/run:rw,size=16m,mode=0755
DropCapability=all
NoNewPrivileges=true

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180
TimeoutStopSec=45
MemoryMax={{ cp_controller_memory_max }}
CPUQuota={{ cp_controller_cpu_quota }}

[Install]
WantedBy=multi-user.target
