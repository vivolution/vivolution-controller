#!/bin/sh
set -eu

case "${1-}" in
  activate|rollback)
    [ "$#" -eq 5 ] || exit 64
    [ "$2" = "--sequence" ] || exit 64
    [ "$4" = "--manifest-digest" ] || exit 64
    case "$3" in ''|*[!0-9]*) exit 64 ;; esac
    edge_digest_length=$(/usr/bin/printf '%s' "$5" | /usr/bin/wc -c)
    [ "$edge_digest_length" -eq 71 ] || exit 64
    case "$5" in sha256:*) ;; *) exit 64 ;; esac
    edge_digest_hex=${5#sha256:}
    case "$edge_digest_hex" in *[!0-9a-f]*) exit 64 ;; esac
    ;;
  health|recover|status)
    [ "$#" -eq 1 ] || exit 64
    ;;
  *) exit 64 ;;
esac

exec /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 \
  /usr/bin/python3 -I -B -c 'import sys; sys.path.insert(0,"/usr/lib/vivolution-edge/python"); from edge.runtime.cli import main; raise SystemExit(main())' "$@"
