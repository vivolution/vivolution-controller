# Managed by the Vivolution Open Edge bootstrap.
# This is a single-NIC endpoint, never a router. Strict reverse-path filtering
# is intentional for the POC's symmetric Azure routing model.
net.ipv4.ip_forward = 0
net.ipv6.conf.all.forwarding = 0

net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.default.accept_redirects = 0
net.ipv4.conf.{{ ansible_facts['default_ipv4']['interface'] }}.accept_redirects = 0
net.ipv6.conf.all.accept_redirects = 0
net.ipv6.conf.default.accept_redirects = 0
net.ipv6.conf.{{ ansible_facts['default_ipv4']['interface'] }}.accept_redirects = 0

net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.default.send_redirects = 0
net.ipv4.conf.{{ ansible_facts['default_ipv4']['interface'] }}.send_redirects = 0

net.ipv4.conf.all.accept_source_route = 0
net.ipv4.conf.default.accept_source_route = 0
net.ipv4.conf.{{ ansible_facts['default_ipv4']['interface'] }}.accept_source_route = 0
net.ipv6.conf.all.accept_source_route = 0
net.ipv6.conf.default.accept_source_route = 0
net.ipv6.conf.{{ ansible_facts['default_ipv4']['interface'] }}.accept_source_route = 0

net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
net.ipv4.conf.{{ ansible_facts['default_ipv4']['interface'] }}.rp_filter = 1
