.DS_Store
*.retry
__pycache__/
*.py[cod]

# Throwaway feasibility spikes and downloaded probe artifacts are never shipped.
.tmp/

# Local deployment state and evidence can contain credentials or host keys.
deploy/.state/
deploy/evidence/

# Generated installer artifacts are rebuilt from the verified Debian ISO.
lab/utm/generated/*
!lab/utm/generated/.gitignore

# Per-host Azure acceptance identity is pinned locally and never committed.
deploy/inventories/azure-single/generated/*
!deploy/inventories/azure-single/generated/.gitignore

# Controller development/build output.
controller/.venv/
controller/.pytest_cache/
controller/**/__pycache__/
controller/staticfiles/
controller/*.sqlite3
deploy/tests/__pycache__/
edge/**/__pycache__/
edge/tests/node_modules/

# Local controller test environment.
controller/.test-venv/
